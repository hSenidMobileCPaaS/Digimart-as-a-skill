# ─────────────────────────────────────────────────────────────────────────────
# Digimart configuration
#
#   cp .env.example .env
#
# `.env` MUST be git-ignored. This file is committed and must only ever contain
# placeholders — never a real API Secret or App Password.
#
# In production do not ship a `.env` at all: use your host's secret manager.
#
# NEVER prefix any of these with NEXT_PUBLIC_ / VITE_ / REACT_APP_ / PUBLIC_ /
# EXPO_PUBLIC_ — those are compiled into the client bundle and become
# world-readable. The API Secret signs charging URLs: anyone who holds it can
# charge your customers.
#
# The variable names are identical in every language template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your application ───────────────────────────────────────────────────────
# Generated at provisioning, e.g. APP_000040. Every notification Digimart sends
# carries it, and your handlers reject any notification that does not match.
DIGIMART_APP_ID=APP_XXXXXX


# ── Charging SDK (signed URLs, opened in the customer's browser) ────────────
# Both shown on the application in the portal once an administrator approves it.
# The secret is never put in a URL — it only contributes to the SHA-512 hash.
DIGIMART_API_KEY=replace-me
DIGIMART_API_SECRET=replace-me

# Your redirect page. Digimart sends the customer's browser here with
# subscriptionStatus, subscriberId and requestId appended. Absolute HTTPS.
DIGIMART_REDIRECT_URL=https://your-app.example/digimart/return

# Uncomment only the flows you sell. An unset URL means that flow is off, and
# the client refuses to build it rather than fail at the platform.
#DIGIMART_SUBSCRIPTION_AUTHORIZE_URL=https://user.digimart.store/sdk/subscription/authorize
#DIGIMART_CAAS_AUTHORIZE_URL=https://user.digimart.store/sdk/subscription/caas-authorize


# ── REST APIs (JSON POST from your server, a DIFFERENT host) ────────────────
# The App Password is emailed to the service provider when the app is created.
# An inbox is not a secret store: move it here (or to your secret manager) and
# delete the mail. It is NOT the API Secret.
DIGIMART_PASSWORD=replace-me

# Uncomment the calls you use.
#DIGIMART_GET_SUBSCRIBERS_URL=https://api.digimart.store/subscription-info-server/getSubscribers
#DIGIMART_CHARGING_INFO_URL=https://api.digimart.store/subscription/getSubscriberChargingInfo
#DIGIMART_UNREGISTRATION_URL=https://api.digimart.store/subs/unregistration
